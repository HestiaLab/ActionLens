@namespace ActionLens.Ui.Components
@using ActionLens.Ui.Services

@*
    One focusable box of the job graph. The state is carried by three redundant channels — a shape, a
    glyph inside a shaped container, and words — because the product promise is that a reader who cannot
    tell an unknown from a definite answer is being lied to, and colour alone cannot keep that promise in
    greyscale, for a screen reader, or for someone with a colour vision deficiency.
*@
<g class="@CssClass"
   role="button"
   tabindex="0"
   aria-label="@AriaLabel"
   aria-current="@(Selected ? "true" : null)"
   @onclick="OnActivated"
   @onkeydown="OnKeyDown">
    <title>@Tooltip</title>
    @if (Tone == "run")
    {
        <rect class="al-node-shape" x="@X" y="@Y" width="@W" height="@H" rx="6" ry="6" />
        <circle class="al-glyph-shape" cx="@GlyphX" cy="@GlyphY" r="10" />
    }
    else if (Tone == "skip")
    {
        <polygon class="al-node-shape" points="@Octagon" />
        <rect class="al-glyph-shape" x="@GlyphSquareX" y="@GlyphSquareY" width="18" height="18" rx="1" />
    }
    else if (Tone == "cycle")
    {
        <polygon class="al-node-shape" points="@Pennant" />
        <polygon class="al-glyph-shape" points="@Diamond" />
    }
    else if (Tone == "blocked")
    {
        <polygon class="al-node-shape" points="@Tag" />
        <polygon class="al-glyph-shape" points="@Diamond" />
    }
    else
    {
        <rect class="al-node-shape" x="@X" y="@Y" width="@W" height="@H" rx="26" ry="26" />
        <polygon class="al-glyph-shape" points="@Triangle" />
    }
    <text class="al-node-glyph" x="@GlyphX" y="@GlyphY" text-anchor="middle" dominant-baseline="central">@Glyph</text>
    <text class="al-node-id" x="@TextX" y="@Line1Y">@ShortId</text>
    <text class="al-node-state" x="@TextX" y="@Line2Y">@StateLine</text>
    <text class="al-node-detail" x="@TextX" y="@Line3Y">@DetailLine</text>
</g>

@code {
    /// <summary>The box the node occupies, in canvas pixels.</summary>
    [Parameter]
    public PixelBox Box { get; set; }

    /// <summary>One of <c>run</c>, <c>skip</c>, <c>unknown</c>, <c>cycle</c>, <c>blocked</c>: picks the shape.</summary>
    [Parameter]
    public string Tone { get; set; } = "unknown";

    /// <summary>The glyph drawn inside the shaped container: <c>+</c>, <c>−</c>, <c>?</c>, <c>↻</c>, <c>!</c>.</summary>
    [Parameter]
    public string Glyph { get; set; } = "?";

    [Parameter]
    public string JobId { get; set; } = string.Empty;

    /// <summary>The state words, e.g. <c>+ Will run</c>. Drawn, and repeated in the accessible name.</summary>
    [Parameter]
    public string StateLine { get; set; } = string.Empty;

    /// <summary>How many runs the box stands for, or why that count is not knowable.</summary>
    [Parameter]
    public string DetailLine { get; set; } = string.Empty;

    [Parameter]
    public string Tooltip { get; set; } = string.Empty;

    [Parameter]
    public string AriaLabel { get; set; } = string.Empty;

    [Parameter]
    public bool Selected { get; set; }

    /// <summary>Fires when the reader clicks the box or presses Enter or Space on it.</summary>
    [Parameter]
    public EventCallback OnActivated { get; set; }

    /// <summary>Forwarded so the canvas can move focus with the arrow keys without breaking Tab order.</summary>
    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    private string CssClass => $"al-graph-node al-node--{Tone}" + (Selected ? " al-node--selected" : string.Empty);

    private string X => GraphGeometry.Number(Box.X);

    private string Y => GraphGeometry.Number(Box.Y);

    private string W => GraphGeometry.Number(Box.Width);

    private string H => GraphGeometry.Number(Box.Height);

    private string GlyphX => GraphGeometry.Number(Box.X + 22);

    private string GlyphY => GraphGeometry.Number(Box.MidY);

    private string GlyphSquareX => GraphGeometry.Number(Box.X + 13);

    private string GlyphSquareY => GraphGeometry.Number(Box.MidY - 9);

    private string TextX => GraphGeometry.Number(Box.X + 38);

    private string Line1Y => GraphGeometry.Number(Box.Y + 20);

    private string Line2Y => GraphGeometry.Number(Box.Y + 36);

    private string Line3Y => GraphGeometry.Number(Box.Y + 52);

    private string ShortId => GraphGeometry.Ellipsis(JobId, 16);

    // Cut corners on all four sides: a shape a reader can tell from the rounded box of a job that runs.
    private string Octagon => Points(
        (Box.X + 14, Box.Y),
        (Box.Right - 14, Box.Y),
        (Box.Right, Box.Y + 14),
        (Box.Right, Box.Bottom - 14),
        (Box.Right - 14, Box.Bottom),
        (Box.X + 14, Box.Bottom),
        (Box.X, Box.Bottom - 14),
        (Box.X, Box.Y + 14));

    // A pennant with an arrow tip, used for the jobs inside a cycle: it is not a place in the schedule.
    private string Pennant => Points(
        (Box.X, Box.Y),
        (Box.Right - 16, Box.Y),
        (Box.Right, Box.MidY),
        (Box.Right - 16, Box.Bottom),
        (Box.X, Box.Bottom));

    // A tag with the left corners clipped, for jobs blocked behind a cycle.
    private string Tag => Points(
        (Box.X + 12, Box.Y),
        (Box.Right, Box.Y),
        (Box.Right, Box.Bottom),
        (Box.X + 12, Box.Bottom),
        (Box.X, Box.MidY));

    private string Diamond => Points(
        (Box.X + 22, Box.MidY - 11),
        (Box.X + 33, Box.MidY),
        (Box.X + 22, Box.MidY + 11),
        (Box.X + 11, Box.MidY));

    private string Triangle => Points(
        (Box.X + 22, Box.MidY - 11),
        (Box.X + 33, Box.MidY + 9),
        (Box.X + 11, Box.MidY + 9));

    private static string Points(params (double X, double Y)[] corners) =>
        string.Join(" ", corners.Select(corner => $"{GraphGeometry.Number(corner.X)},{GraphGeometry.Number(corner.Y)}"));
}
