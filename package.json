{
  "name": "actionlens-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Node-side build for ActionLens's editor bundle (CodeMirror 6), plus Gate 2's Playwright browser suite.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:editor": "node scripts/build-editor.mjs",
    "watch:editor": "node scripts/build-editor.mjs --watch",
    "seed:offline": "node scripts/seed-offline-node-modules.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.1"
  }
}
