<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core: YAML parsing only. No Blazor, no JS interop. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />

    <!-- App: Atlas workspace shell, pinned to the published 0.4.0 package. -->
    <PackageVersion Include="Atlas.Blazor" Version="0.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />

    <!-- Ui (Razor class library): the shared Framework component/web assembly, same 10.0.x line. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />

    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- bUnit 2.x ships one assembly with no xunit dependency, so it runs on xunit.v3 directly:
         tests construct a BunitContext per test instead of using the (preview-only) bunit.xunit glue. -->
    <PackageVersion Include="bunit" Version="2.13.3" />
  </ItemGroup>

</Project>
